# Nothing is built here yet. This file covers only what the current contents can
# produce; it grows when the project does.

# Editors and tooling
.idea/
*.iml
.vscode/
.zed/
*.swp

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode from tool/
__pycache__/
*.py[cod]

# What the application writes beside a logbook: an import staged for review, the folder an agent
# is started in, a change an agent staged, and the lock a window holds while it has the logbook
# open. All sit next to the logbook rather than inside it, which puts them here when the logbook
# being worked on is a fixture.
*.import/
*.agent/
*.proposed/
*.lock/

# Gradle build output
.gradle/
build/

# Kotlin's own scratch space, beside the Gradle one
.kotlin/
